APP_ENV=local
LOG_LEVEL=INFO

# 本地单节点 CockroachDB 可用 sslmode=disable；云端必须改为平台提供的安全连接串。
DATABASE_URL=postgresql+psycopg://root@127.0.0.1:26257/experiment_guardian?sslmode=disable
DATABASE_ECHO=false

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ACCESS_TOKEN=
MANIFEST_HASH_ALGORITHM=sha256

AWS_REGION=us-east-1
S3_BUCKET=
S3_PRESIGN_EXPIRES_SECONDS=900

# R12a Worker 必填；API 可以在未配置时仅持久化待投递 Outbox。
SQS_SUBMISSION_QUEUE_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=120
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=5
BEDROCK_SUMMARY_MODEL_ID=
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60
