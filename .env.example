APP_ENV=development
DEPLOYMENT_MODE=cloud
LOG_LEVEL=INFO
API_HOST=127.0.0.1

# 本地单节点 CockroachDB 可用 sslmode=disable；云端必须改为平台提供的安全连接串。
DATABASE_URL=cockroachdb+psycopg://root@127.0.0.1:26257/experiment_guardian?sslmode=disable
DATABASE_ECHO=false

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ACCESS_TOKEN=
MCP_PUBLIC_URL=
MCP_OAUTH_RESOURCE_IDENTIFIER=
MCP_OAUTH_SCOPE_PREFIX=experiment-guardian
MANIFEST_HASH_ALGORITHM=sha256

# 云端人类用户通过 Cognito Managed Login；浏览器只接收服务端 Session Cookie。
WEB_AUTH_MODE=cognito
LOCAL_OWNER_EMAIL=
WEB_PUBLIC_BASE_URL=http://127.0.0.1:8000
WEB_FRONTEND_URL=http://127.0.0.1:5173
WEB_SESSION_COOKIE_NAME=eg_session
WEB_CSRF_COOKIE_NAME=eg_csrf
WEB_SESSION_IDLE_SECONDS=28800
WEB_SESSION_ABSOLUTE_SECONDS=604800
WEB_RECENT_AUTH_SECONDS=600
OIDC_TRANSACTION_TTL_SECONDS=300
COGNITO_ISSUER_URL=
COGNITO_DOMAIN=
COGNITO_WEB_CLIENT_ID=
COGNITO_WEB_CLIENT_SECRET=
# 生产环境使用两个不同的高熵 Secrets Manager 值，不能沿用应用默认开发值。
WEB_OIDC_STATE_KEY=
WEB_CSRF_SECRET=

AWS_REGION=us-east-1
OBJECT_STORAGE_BACKEND=aws_s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PRESIGN_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_EXPIRES_SECONDS=900

# R12b Worker 使用同一个队列处理摘要和审核准备；API 可只持久化待投递 Outbox。
QUEUE_BACKEND=sqs
SQS_SUBMISSION_QUEUE_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=120
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=5
DATABASE_QUEUE_POLL_INTERVAL_SECONDS=1
DATABASE_QUEUE_BATCH_SIZE=10
LLM_PROVIDER=bedrock
BEDROCK_SUMMARY_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_SUMMARY_MODEL=
BAILIAN_EMBEDDING_MODEL=
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_CONNECT_TIMEOUT_SECONDS=5
BAILIAN_READ_TIMEOUT_SECONDS=60

# R15a 内部治理 Agent。关闭时不会校验 Agent 模型配置。
AGENT_ENABLED=false
AGENT_PROVIDER=bailian
BAILIAN_AGENT_MODEL=
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_WALL_SECONDS=90
AGENT_CONTEXT_TOKEN_BUDGET=12000
AGENT_RECENT_MESSAGE_LIMIT=12
AGENT_SUMMARY_MIN_NEW_MESSAGES=6
AGENT_SUMMARY_MAX_OUTPUT_TOKENS=1200
AGENT_TOOL_OUTPUT_MAX_BYTES=32768
AGENT_MAX_OUTPUT_TOKENS=1800
AGENT_RUN_LEASE_SECONDS=120
AGENT_RUN_MAX_ATTEMPTS=3
AGENT_RUN_POLL_INTERVAL_SECONDS=1
AGENT_SSE_POLL_INTERVAL_SECONDS=0.5
AGENT_SSE_HEARTBEAT_SECONDS=15
