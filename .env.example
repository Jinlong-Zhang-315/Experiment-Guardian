APP_ENV=local
LOG_LEVEL=INFO

# 本地单节点 CockroachDB 可用 sslmode=disable；云端必须改为平台提供的安全连接串。
DATABASE_URL=postgresql+psycopg://root@127.0.0.1:26257/experiment_guardian?sslmode=disable
DATABASE_ECHO=false

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ACCESS_TOKEN=
MANIFEST_HASH_ALGORITHM=sha256

AWS_REGION=us-east-1
S3_BUCKET=
BEDROCK_MODEL_ID=
EMBEDDING_DIMENSION=1536
