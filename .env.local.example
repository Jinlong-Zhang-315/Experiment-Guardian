APP_ENV=development
DEPLOYMENT_MODE=local
LOG_LEVEL=INFO
# Docker 构建默认使用官方 PyPI；受限网络可在 .env.local 中覆盖此值。
PIP_INDEX_URL=https://pypi.org/simple

DATABASE_URL=cockroachdb+psycopg://root@cockroachdb:26257/experiment_guardian?sslmode=disable
DATABASE_ECHO=false

WEB_AUTH_MODE=local_owner
LOCAL_OWNER_EMAIL=owner@example.com
WEB_PUBLIC_BASE_URL=http://127.0.0.1:8000
WEB_FRONTEND_URL=http://127.0.0.1:5173
WEB_SESSION_COOKIE_NAME=eg_session
WEB_CSRF_COOKIE_NAME=eg_csrf
WEB_SESSION_IDLE_SECONDS=28800
WEB_SESSION_ABSOLUTE_SECONDS=604800
WEB_RECENT_AUTH_SECONDS=600
WEB_OIDC_STATE_KEY=change-this-local-oidc-state-key-32-chars
WEB_CSRF_SECRET=change-this-local-csrf-secret-key-32-chars

OBJECT_STORAGE_BACKEND=s3_compatible
S3_ENDPOINT_URL=http://minio:9000
S3_PRESIGN_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=experiment-guardian
S3_ACCESS_KEY=experiment-guardian
S3_SECRET_KEY=change-this-local-secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=900

QUEUE_BACKEND=database
DATABASE_QUEUE_POLL_INTERVAL_SECONDS=1
DATABASE_QUEUE_BATCH_SIZE=10
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=5

LLM_PROVIDER=bailian
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_SUMMARY_MODEL=
BAILIAN_EMBEDDING_MODEL=
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_CONNECT_TIMEOUT_SECONDS=5
BAILIAN_READ_TIMEOUT_SECONDS=60

# 内部治理 Agent 默认关闭。启用时同时填写 BAILIAN_AGENT_MODEL，并使用
# `docker compose --profile agent ...` 启动独立 Agent Worker。
AGENT_ENABLED=false
AGENT_PROVIDER=bailian
BAILIAN_AGENT_MODEL=
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_WALL_SECONDS=90
AGENT_CONTEXT_TOKEN_BUDGET=24000
AGENT_RECENT_MESSAGE_LIMIT=12
AGENT_TOOL_OUTPUT_MAX_BYTES=32768
AGENT_MAX_OUTPUT_TOKENS=1800
AGENT_RUN_LEASE_SECONDS=120
AGENT_RUN_MAX_ATTEMPTS=3
AGENT_RUN_POLL_INTERVAL_SECONDS=1
AGENT_SSE_POLL_INTERVAL_SECONDS=0.5
AGENT_SSE_HEARTBEAT_SECONDS=15

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ACCESS_TOKEN=
MANIFEST_HASH_ALGORITHM=sha256

API_PORT=8000
WEB_PORT=5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
COCKROACH_SQL_PORT=26257
COCKROACH_HTTP_PORT=8080
